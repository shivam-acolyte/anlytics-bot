# ==============================================================================
# TrackingBot Streamlit Community Cloud Secrets Template
# ==============================================================================
# To configure secrets in Streamlit Community Cloud:
# 1. Go to your deployed app dashboard at https://share.streamlit.io
# 2. Click App Settings -> Secrets
# 3. Paste the contents below and replace placeholder credentials
# ==============================================================================

# PostgreSQL Database (🏢 Acolyte Living)
DB_HOST = "165.99.228.81"
DB_PORT = "6432"
DB_USER = "al_all"
DB_PASSWORD = "your_postgres_password"
DB_NAME = "acolye-living-v2"

# MySQL Database (🌸 StartupFlora)
MYSQL_HOST = "165.99.228.81"
MYSQL_PORT = "3306"
MYSQL_USER = "ART"
MYSQL_PASSWORD = "your_mysql_password"
MYSQL_DATABASE = "insights_db"

# AI Analytics Assistant (OpenAI GPT-4o-mini)
OPENAI_API_KEY = "sk-proj-your-openai-api-key"
OPENAI_MODEL = "gpt-4o-mini"

# Optional App Tuning
DEBUG = "False"
APP_NAME = "TrackingBot Analytics & AI Platform"
ANALYTICS_TABLES = "tracking_events,tracking_sessions,tracking_users,tracking_ip_locations"
